# Usado pelo docker-compose (perfil "prod" com Postgres).
# Copie este arquivo para ".env" e preencha com valores próprios — sem eles,
# o container da API recusa subir (ver docker-compose.yml).

# Gere um valor longo e aleatório, ex: openssl rand -base64 48
JWT_SECRET=

# Credenciais do usuário admin criado na primeira inicialização.
SEED_ADMIN_EMAIL=admin@vetclinic.com
SEED_ADMIN_PASSWORD=

# Domínio(s) do frontend com permissão de chamar a API entre origens,
# separados por vírgula (ex: https://meu-frontend.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:8080
